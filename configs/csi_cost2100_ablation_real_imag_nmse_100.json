{
  "task": "csi",
  "seed": 2026,
  "deterministic": true,
  "output_dir": "../outputs/csi_cost2100_ablation_real_imag_nmse_100",
  "data": {
    "train_path": "../data/cost2100/original/DATA_Htrainout.mat",
    "validation_path": "../data/cost2100/original/DATA_Hvalout.mat",
    "test_path": "../data/cost2100/original/DATA_Htestout.mat",
    "train_key": "HT",
    "validation_key": "HT",
    "test_key": "HT",
    "representation": "real_imag",
    "metric_center": 0.5,
    "already_angular_delay": true,
    "bandwidth_ratio": 0.125,
    "batch_size": 512,
    "evaluation_batch_size": 256,
    "validation_samples": 30000,
    "num_workers": 0
  },
  "model": {
    "in_channels": 2,
    "spatial_size": [32, 32],
    "channel_multiplier": 2,
    "kernel_size": 3,
    "residual_kernel_size": 3
  },
  "channel": {"fading_gain": 1.0},
  "training": {
    "loss": "nmse",
    "epochs": 100,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "snr_db": 10.0,
    "validation_snr_db": 10.0,
    "checkpoint_interval": 25
  },
  "evaluation": {
    "snr_db": [0, 5, 10, 15, 20],
    "max_samples": 5000,
    "channel_repeats": 1
  },
  "attacks": {
    "target_quality_db": -16.0,
    "max_samples": 128,
    "pga": {
      "step_size": 0.1,
      "eps": 1e-8,
      "max_steps": 200,
      "refine_steps": 0,
      "batch_size": 16
    },
    "cw": {
      "learning_rate": 0.01,
      "initial_c": 1.0,
      "c_min": 1e-6,
      "c_max": 100.0,
      "binary_search_steps": 3,
      "max_steps": 500,
      "kappa": 0.0,
      "early_stop_on_success": true,
      "batch_size": 1
    }
  }
}
